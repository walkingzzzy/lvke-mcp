{
  "mcpServers": {
    "lvke-asset-acquisition": {
      "command": "python",
      "args": ["-m", "lvke_mcp.servers.lvke_asset_acquisition.server"],
      "env": {
        "LVKE_MCP_DATA_DIR": "${LVKE_MCP_DATA_DIR}"
      }
    },
    "lvke-data-acquisition": {
      "command": "python",
      "args": ["-m", "lvke_mcp.servers.lvke_data_acquisition.server"],
      "env": {
        "LVKE_MCP_DATA_DIR": "${LVKE_MCP_DATA_DIR}",
        "TAVILY_MCP_URL": "https://tavily.ivanli.cc/mcp",
        "TAVILY_MCP_BEARER_TOKEN_FILE": "${TAVILY_MCP_BEARER_TOKEN_FILE}",
        "LVKE_EXTERNAL_EXTRACT_RECEIPT_SECRET_FILE": "${LVKE_EXTERNAL_EXTRACT_RECEIPT_SECRET_FILE}",
        "LVKE_MCP_TRUSTED_HTTPS_PRIVATE_IP_HOSTS": "${LVKE_MCP_TRUSTED_HTTPS_PRIVATE_IP_HOSTS}"
      },
      "env_vars": [
        "TAVILY_MCP_URL",
        "TAVILY_MCP_BEARER_TOKEN",
        "TAVILY_MCP_BEARER_TOKEN_FILE",
        "LVKE_EXTERNAL_EXTRACT_RECEIPT_SECRET",
        "LVKE_EXTERNAL_EXTRACT_RECEIPT_SECRET_FILE",
        "LVKE_MCP_TRUSTED_HTTPS_PRIVATE_IP_HOSTS"
