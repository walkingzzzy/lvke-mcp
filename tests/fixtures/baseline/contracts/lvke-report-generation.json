  {
    "name": "report_apply",
    "description": "应用已核对提案并生成新修订；默认执行结构与财务一致性检查。enforce_structure=false 仅跳过章节结构校验（技术验证用途），不影响财务一致性校验。",
    "inputSchema": {
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "proposal_id": {
          "type": "string",
          "minLength": 1
        },
        "enforce_structure": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
