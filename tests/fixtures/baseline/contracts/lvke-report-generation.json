    "name": "report_get_section",
    "description": "按稳定 section_id 读取指定 revision 的章节正文，不按章号猜测。",
    "inputSchema": {
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "report_revision_id": {
          "type": "string",
          "minLength": 1
        },
        "section_id": {
