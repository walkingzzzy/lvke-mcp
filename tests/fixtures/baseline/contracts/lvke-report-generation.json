  {
    "name": "report_export_docx",
    "description": "生成 draft 或经确定性工程校验的 formal_candidate 不可变 DOCX 工件；项目目录镜像必须显式启用。",
    "inputSchema": {
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "report_revision_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "draft",
            "formal_candidate"
          ],
          "default": "draft"
        },
        "mirror_to_project": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "workspace_id",
        "report_revision_id"
      ],
      "type": "object",
