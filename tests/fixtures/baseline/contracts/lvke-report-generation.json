[
  {
    "name": "report_prepare",
    "description": "校验 evidence/research 与类型化财务绑定；通用和资产收购分别查询对应领域服务。",
    "inputSchema": {
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_pack_ids": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "research_package_ids": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "finance_binding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "generic_feasibility",
                "asset_acquisition"
              ]
            },
            "run_id": {
              "type": "string",
              "minLength": 1
            },
            "package_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "run_id",
            "package_id"
          ]
        },
        "run_id": {
          "type": "string"
        },
        "finance_tables_package_id": {
          "type": "string"
        },
        "outline": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "section_id": {
                    "type": "string",
                    "pattern": "^sec_[a-z0-9][a-z0-9_-]{2,79}$"
                  },
                  "parent_section_id": {
                    "type": "string"
                  },
                  "depth": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 6
                  }
                },
                "required": [
                  "title"
                ]
              }
            ]
          }
        },
        "template_version": {
          "type": "string"
        },
        "evidence_policy": {
          "type": "string"
        },
        "project_fact_certified": {
          "type": "boolean"
        },
        "reconstruction_records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "reconstructed_source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "release_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "project_context_id": {
          "type": "string"
        },
        "upstream_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "workspace_id",
        "evidence_pack_ids",
        "research_package_ids"
      ],
      "type": "object",
      "additionalProperties": false,
      "x-lvke-schema-uri": "lvke://schemas/report-preparation"
    },
    "outputSchema": null,
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "taskSupport": "forbidden"
  },
  {
    "name": "report_start",
    "description": "创建绑定上游依据的 Agent 草稿会话；必须提交不可变正文快照。",
    "inputSchema": {
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "report_preparation_id": {
          "type": "string",
          "minLength": 1
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "document_snapshot": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "workspace_id": {
              "type": "string",
              "minLength": 1
            },
            "revision_id": {
              "type": "string"
            },
            "report_type": {
              "type": "string"
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "content"
          ]
        }
      },
      "required": [
        "workspace_id",
        "report_preparation_id"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "outputSchema": null,
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "taskSupport": "forbidden"
  },
  {
    "name": "report_status",
    "description": "固化 Agent 当前草稿为绑定上游 basis 的 report_revision_id；不运行任何内置模型。",
