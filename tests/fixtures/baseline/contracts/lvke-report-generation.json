  {
    "name": "report_propose_section",
    "description": "为稳定 section_id 创建普通 proposal；仍必须 report_diff → report_apply。",
    "inputSchema": {
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "report_revision_id": {
          "type": "string",
          "minLength": 1
        },
        "section_id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "proposed_content": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "report_preparation_id": {
              "type": "string",
              "minLength": 1
            },
            "basis_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "report_revision_id": {
              "type": "string",
              "minLength": 1
            },
            "upstream_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "citation_locators": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "upstream_basis_hashes": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "report_preparation_id",
            "basis_hash"
          ]
        }
      },
      "required": [
        "workspace_id",
        "report_revision_id",
        "section_id",
        "summary",
        "proposed_content",
        "basis"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "outputSchema": null,
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "taskSupport": "forbidden"
  },
