          "maximum": 1,
          "default": 0.08
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1,
          "default": "base"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
