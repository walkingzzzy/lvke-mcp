                "type": "number"
              },
              "minItems": 1,
              "maxItems": 64
            },
            "lease_portfolio.market_rent": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1,
              "maxItems": 64
            },
            "hotel_operation.adr": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1,
              "maxItems": 64
            },
            "hotel_operation.occupancy": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1,
              "maxItems": 64
