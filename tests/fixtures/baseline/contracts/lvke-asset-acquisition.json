      },
      "required": [
        "spec"
      ],
      "type": "object",
      "additionalProperties": false,
      "x-lvke-schema-uri": "lvke://schemas/lvke-asset-acquisition/acquisition_validate_spec/input"
    },
    "outputSchema": null,
