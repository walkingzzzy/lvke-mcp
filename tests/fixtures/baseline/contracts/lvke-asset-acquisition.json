  {
    "name": "acquisition_confirm_spec",
    "description": "以新不可变修订确认候选 Spec；process_acceptance 保留 source_reconstructed 与未决业务事实。",
    "inputSchema": {
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "spec_id": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "default": ""
        },
        "confirmation_scope": {
          "type": "string",
          "enum": [
            "project_candidate",
            "process_acceptance"
          ],
          "default": "project_candidate"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "workspace_id",
        "spec_id",
        "idempotency_key"
      ],
      "type": "object",
      "additionalProperties": false
