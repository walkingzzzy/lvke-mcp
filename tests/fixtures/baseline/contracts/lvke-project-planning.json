[
  {
    "name": "project_context_create",
    "description": "创建不可变 ProjectContext 草稿；身份由 MCP 宿主绑定，重复请求由幂等键保护。",
    "inputSchema": {
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "project_name": {
              "type": "string",
              "minLength": 1
            },
            "industry_code": {
              "type": "string",
              "minLength": 1
            },
            "project_type": {
              "type": "string",
              "enum": [
                "new_build",
                "expansion",
                "renovation",
                "acquisition",
                "operation_lease",
                "other"
              ]
            },
            "region": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "country": {
                  "type": "string",
                  "default": "中国"
                },
                "province": {
                  "type": "string",
                  "minLength": 1
                },
                "city": {
                  "type": "string"
                },
                "district": {
                  "type": "string"
                },
                "address": {
                  "type": "string"
                },
                "administrative_code": {
                  "type": "string"
                }
              },
              "required": [
                "province"
              ]
            },
            "objective": {
              "type": "string",
              "minLength": 1
            },
            "report_type": {
              "type": "string",
              "enum": [
                "feasibility_study",
                "project_application",
                "investment_decision",
                "technical_validation",
                "other"
              ]
            },
            "transaction_structure": {
              "type": "string",
              "enum": [
                "none",
                "greenfield",
                "asset_transfer",
                "equity_transfer",
                "operation_lease",
                "ppp",
                "other"
              ],
              "default": "none"
            },
            "target_type": {
              "type": "string",
              "enum": [
                "project",
                "company",
                "asset",
                "concession",
                "other"
              ]
            },
            "asset_type": {
              "type": "string",
              "enum": [
                "none",
                "solar_power",
                "hotel_lease",
                "amusement_park",
                "industrial",
                "infrastructure",
                "other"
              ]
            },
            "evidence_track": {
              "type": "string",
              "enum": [
                "real",
                "source_reconstructed",
                "technical_fixture",
                "controlled_assumption"
              ],
              "default": "real"
            },
            "tags": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "default": []
            }
          },
          "minProperties": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "workspace_id",
        "context",
        "idempotency_key"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "outputSchema": null,
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "taskSupport": "forbidden"
  },
