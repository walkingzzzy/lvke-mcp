  {
    "name": "planning_solve_build_scale",
    "description": "对多个规模方案确定性计算产能、用地、容积率、密度和绿地约束。",
    "inputSchema": {
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "project_context_id": {
          "type": "string",
          "minLength": 1
        },
        "market_case_id": {
          "type": "string",
          "minLength": 1
        },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "candidate_id": {
                "type": "string",
                "minLength": 1
              },
              "target_capacity": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "value",
                  "unit"
                ]
              },
              "land_area_m2": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "capacity_intensity_per_m2": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "constraints": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "plot_ratio_min": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 20
                  },
                  "plot_ratio_max": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 20
                  },
                  "building_coverage_max": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  },
                  "green_ratio_min": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "green_area_m2": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "plot_ratio_min",
                  "plot_ratio_max",
                  "building_coverage_max",
                  "green_ratio_min",
                  "green_area_m2"
                ]
              },
              "facilities": {
                "type": "array",
                "minItems": 1,
                "maxItems": 200,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "purpose": {
                      "type": "string",
                      "minLength": 1
                    },
                    "floor_area_m2": {
                      "type": "number",
                      "minimum": 0
                    },
                    "footprint_m2": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "name",
                    "purpose",
                    "floor_area_m2",
                    "footprint_m2"
                  ]
                }
              },
              "notes": {
                "type": "string",
                "maxLength": 5000
              }
            },
            "required": [
              "candidate_id",
              "target_capacity",
              "land_area_m2",
              "capacity_intensity_per_m2",
              "constraints",
              "facilities"
            ]
          }
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "workspace_id",
        "project_context_id",
        "market_case_id",
        "alternatives",
        "idempotency_key"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "outputSchema": null,
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "taskSupport": "forbidden"
  },
