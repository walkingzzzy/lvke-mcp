  {
    "name": "feasibility_start",
    "description": "创建不可变可研交付运行和阶段清单。",
    "inputSchema": {
      "properties": {
        "workspace_id": {
          "type": "string",
          "minLength": 1
        },
        "project_context_id": {
          "type": "string",
          "minLength": 1
        },
        "delivery_mode": {
          "type": "string",
          "enum": [
            "estimate_preview",
            "review_candidate",
            "formal_release"
          ]
        },
        "evidence_policy": {
          "type": "string",
          "enum": [
            "formal_evidence",
            "source_reconstructed",
            "technical_fixture",
            "controlled_assumption"
          ]
        },
        "release_scope": {
          "type": "string",
          "enum": [
            "process_acceptance",
            "project_delivery"
          ]
        },
        "project_fact_certified": {
          "type": "boolean"
        },
        "reconstructed_source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reconstruction_records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "unresolved_inputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "release_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "workspace_id",
        "delivery_mode",
        "idempotency_key"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "outputSchema": null,
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
