        },
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "accepted",
            "partial",
            "empty",
            "missing_inputs",
            "blocked",
            "incomplete",
            "failed",
            "upstream_failure"
          ],
          "description": "业务状态；partial/missing_inputs/blocked 不是系统错误"
