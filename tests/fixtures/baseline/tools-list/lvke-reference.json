    "execution": {
      "taskSupport": "forbidden"
    },
    "inputSchema": {
      "properties": {
        "dataset": {
          "type": "string",
          "enum": [
            "industry_reports",
            "clients",
            "experts",
            "policies",
            "archive"
          ]
        },
        "query": {
          "type": "string"
        },
        "filters": {
          "type": "object"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 20
        }
      },
